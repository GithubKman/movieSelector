# Copy to .env (loaded by `make dev`) or pass as container environment variables.

LISTEN_ADDR=:8088
DB_PATH=data/movies.db
# Public URL of the site, used for links in emails.
BASE_URL=http://localhost:8088

# Required for management mode and the write API. Generate with: openssl rand -hex 16
ADMIN_TOKEN=change-me

# Free key from https://www.themoviedb.org/settings/api (v3 key or v4 read token).
# Leave empty to use the built-in demo catalog.
TMDB_API_KEY=

# Daily digest email. Local testing: run `make mail` and use the values below,
# then open http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=movieselector@localhost
# Comma-separated recipients.
NOTIFY_EMAIL=you@example.com
# Local time (set TZ) to send the digest each day; "off" disables it.
NOTIFY_AT=09:00
# TZ=Europe/London
